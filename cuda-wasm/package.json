{
  "name": "cuda-wasm",
  "version": "2.0.1",
  "description": "Node.js wrapper for cuda2rust: generate Rust or WGSL source from a subset of CUDA C++",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "cuda-wasm": "./cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run validate:package",
    "test": "node --test tests/package-security.cjs tests/node-wrapper.test.cjs",
    "test:security": "node --test tests/package-security.cjs tests/node-wrapper.test.cjs",
    "test:integration": "node --test tests/cli-integration.cjs",
    "validate:package": "node scripts/validate-package.js",
    "prepack": "npm run validate:package",
    "prepublishOnly": "npm run validate:package",
    "audit": "npm audit --audit-level=low"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruv-FANN.git",
    "directory": "cuda-wasm"
  },
  "keywords": [
    "cuda",
    "transpiler",
    "rust",
    "wgsl",
    "cli",
    "source-generation"
  ],
  "author": {
    "name": "CUDA-WASM Team",
    "url": "https://github.com/ruvnet/ruv-FANN"
  },
  "contributors": [
    {
      "name": "VibeCast Team",
      "url": "https://github.com/vibecast"
    }
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ruvnet/ruv-FANN/issues"
  },
  "homepage": "https://ruv.io",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ruvnet"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist/index.js",
    "dist/index.mjs",
    "dist/index.d.ts",
    "cli/index.js",
    "scripts/validate-package.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/assets/source-flow.svg"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "type": "commonjs"
}
