{
  "name": "@ruv-fann/napi",
  "version": "0.1.0",
  "description": "Native Node-API 8 inference and reverse-mode training for the actual ruv-FANN Rust core",
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.cjs" },
    "./native": "./ruv_fann.node"
  },
  "files": ["index.cjs", "index.mjs", "index.d.ts", "ruv_fann.node", "build-info.json", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "engines": { "node": ">=22.13.0" },
  "license": "MIT OR Apache-2.0",
  "homepage": "https://ruv.io",
  "repository": { "type": "git", "url": "https://github.com/ruvnet/ruv-FANN.git", "directory": "bindings/napi" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:consumer": "node test/packed-consumer.mjs"
  }
}
