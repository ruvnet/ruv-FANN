{
  "schema": "npm.metadata-release/1",
  "repository": "ruvnet/ruv-FANN",
  "releaseTag": "ruv-fann-metadata-v1",
  "bootstrap": [
    [
      "npm",
      "ci",
      "--prefix",
      "packages/wsp-toolkit",
      "--ignore-scripts",
      "--no-audit",
      "--no-fund"
    ],
    [
      "npm",
      "run",
      "--prefix",
      "packages/wsp-toolkit",
      "setup:agentdb"
    ],
    [
      "node",
      "packages/wsp-toolkit/node_modules/playwright/cli.js",
      "install",
      "--with-deps",
      "chromium"
    ]
  ],
  "packages": [
    {
      "name": "ruv-fann-wasm",
      "directory": "packages/wasm",
      "fromVersion": "0.1.2",
      "toVersion": "0.1.3",
      "overlays": [
        "README.md"
      ]
    },
    {
      "name": "ruv-fann-wsp",
      "directory": "packages/wsp",
      "fromVersion": "0.2.0",
      "toVersion": "0.2.1",
      "overlays": [
        "README.md"
      ]
    },
    {
      "name": "ruv-fann-wsp-lifecycle",
      "directory": "packages/wsp-toolkit/packages/lifecycle",
      "fromVersion": "0.1.0",
      "toVersion": "0.1.1",
      "overlays": [
        "README.md",
        "constellation.json"
      ]
    },
    {
      "name": "ruv-fann-wsp-search",
      "directory": "packages/wsp-toolkit/packages/search",
      "fromVersion": "0.1.0",
      "toVersion": "0.1.1",
      "overlays": [
        "README.md",
        "constellation.json"
      ]
    },
    {
      "name": "ruv-fann-wsp-huggingface",
      "directory": "packages/wsp-toolkit/packages/huggingface",
      "fromVersion": "0.1.0",
      "toVersion": "0.1.1",
      "overlays": [
        "README.md",
        "constellation.json"
      ]
    },
    {
      "name": "ruv-fann-wsp-cloudflare",
      "directory": "packages/wsp-toolkit/packages/cloudflare",
      "fromVersion": "0.1.0",
      "toVersion": "0.1.1",
      "overlays": [
        "README.md",
        "constellation.json"
      ]
    },
    {
      "name": "ruv-fann-wsp-ruos",
      "directory": "packages/wsp-toolkit/packages/ruos",
      "fromVersion": "0.1.0",
      "toVersion": "0.1.1",
