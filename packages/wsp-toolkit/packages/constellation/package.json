{
  "name": "ruvnet-constellation",
  "version": "0.1.1",
  "type": "module",
  "description": "Discover versioned RuvNet packages, plan explicit installs and scaffold local integration adapters with a lightweight CLI.",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./catalog.json": "./catalog.json"
  },
  "bin": {
    "constellation": "./src/cli.js"
  },
  "files": [
    "src",
    "catalog.json",
    "README.md",
    "LICENSE",
    "constellation.json"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "ruvnet-constellation-contracts": "0.1.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruv-FANN.git",
    "directory": "packages/wsp-toolkit/packages/constellation"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ruvnet",
    "constellation",
    "package-discovery",
    "cli",
    "integration",
    "scaffolding",
    "package-catalog",
    "npm",
    "npm-packages",
    "package-metadata",
    "install-planning",
    "version-pinning",
    "module-manifest",
    "local-scaffolding",
    "integration-adapters",
    "developer-tools",
    "javascript",
    "typescript",
    "nodejs",
    "esm",
    "modular-packages",
    "json-catalog"
  ],
  "homepage": "https://ruvnet.github.io/ruv-FANN/",
  "bugs": {
    "url": "https://github.com/ruvnet/ruv-FANN/issues"
  }
}
