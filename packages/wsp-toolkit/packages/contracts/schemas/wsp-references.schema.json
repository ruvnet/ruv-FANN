    "ruv-fann.invariants/1",
    "ruv-fann.invariant-check/1",
    "ruv-fann.evolution-loop/1"
  ],
  "x-canonicalSources": {
    "model": "https://github.com/ruvnet/ruv-FANN/tree/main/packages/core",
    "patchAndEvaluation": "https://github.com/ruvnet/ruv-FANN/tree/main/packages/wsp",
    "invariantsAndLoop": "https://github.com/ruvnet/ruv-FANN/tree/main/packages/wsp-toolkit"
  }
