{
  "name": "ruvnet-constellation-contracts",
  "version": "0.1.0",
  "description": "Validate bounded JSON catalogs and module manifests for independently installable RuvNet packages.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "src",
    "schemas",
    "README.md",
    "LICENSE",
    "constellation.json"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruv-FANN.git",
    "directory": "packages/wsp-toolkit/packages/contracts"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ruvnet",
    "constellation",
    "json-schema",
    "validation",
    "package-catalog",
    "module-manifest"
  ],
  "homepage": "https://ruvnet.github.io/ruv-FANN/",
  "bugs": {
    "url": "https://github.com/ruvnet/ruv-FANN/issues"
  }
}
