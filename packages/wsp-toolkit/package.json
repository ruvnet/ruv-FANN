{
  "name": "ruv-fann-wsp-toolkit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test packages/*/test/*.test.mjs test/*.test.mjs",
    "test:unit": "node --test packages/*/test/*.test.mjs",
    "test:e2e": "node --test test/*.test.mjs",
    "check:types": "tsc --noEmit -p tsconfig.json",
    "benchmark": "node scripts/benchmark.mjs",
    "validate": "node scripts/validate.mjs",
    "test:hub:live": "node scripts/huggingface-live.mjs",
    "audit": "npm audit --audit-level=high && npm --prefix tooling/agentdb run audit",
    "setup:agentdb": "npm ci --prefix tooling/agentdb --omit=optional --ignore-scripts --no-audit --no-fund",
    "demo:loop": "node scripts/evolution-demo.mjs",
    "test:loop": "node --test packages/loop/test/*.test.mjs packages/swarm/test/*.test.mjs packages/invariants/test/*.test.mjs packages/registry/test/*.test.mjs",
    "constellation": "node packages/constellation/src/cli.js",
    "constellation:report": "node scripts/constellation-report.mjs",
    "constellation:links": "node scripts/constellation-links.mjs",
    "constellation:check": "node scripts/constellation-links.mjs --check"
  },
  "dependencies": {
    "ruv-fann-wsp": "0.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "playwright": "1.56.1",
    "miniflare": "4.20260730.0",
    "esbuild": "0.28.2"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    }
  }
}
