{
  "name": "ruv-fann",
  "version": "0.1.1",
  "description": "Neural networks for JavaScript and TypeScript: WebAssembly batch inference and SGD/AdamW training in Node.js and browsers.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "dependencies": {
    "ruv-fann-wasm": "0.1.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "benchmark": "node test/benchmark.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruv-FANN.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ruv-fann",
    "fann",
    "neural-network",
    "neural-networks",
    "machine-learning",
    "webassembly",
    "wasm",
    "simd",
    "javascript",
    "typescript",
    "nodejs",
    "browser",
    "inference",
    "training",
    "sgd",
    "adamw",
    "agentdb"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "homepage": "https://github.com/ruvnet/ruv-FANN/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ruvnet/ruv-FANN/issues"
  }
}
