{
  "name": "ruv-fann-wasm",
  "version": "0.1.3",
  "description": "WebAssembly neural network runtime for Node.js and browsers: ruv-FANN binaries, SIMD detection and typed ESM bindings.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "scripts": {
    "build": "node ../../scripts/npm-modules-build.mjs",
    "prepack": "npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ruvnet/ruv-FANN.git",
    "directory": "packages/wasm"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ruv-fann",
    "fann",
    "neural-network",
    "neural-networks",
    "machine-learning",
    "webassembly",
    "wasm",
    "simd",
    "javascript",
    "typescript",
    "nodejs",
    "browser",
    "inference",
    "wasm-bindgen",
    "rust",
    "runtime",
    "dense-neural-network",
    "esm",
    "wasm-runtime",
    "simd-detection",
    "batch-inference",
    "neural-inference"
  ],
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "homepage": "https://github.com/ruvnet/ruv-FANN/tree/main/packages/wasm#readme",
  "bugs": {
    "url": "https://github.com/ruvnet/ruv-FANN/issues"
  }
}
