{
  "name": "@ruv-fann/integrations",
  "version": "0.1.0",
  "description": "Optional RuVector search and MetaHarness tuning for real ruv-FANN prepared inference",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs" },
    "./ruvector": { "types": "./src/ruvector.d.ts", "import": "./src/ruvector.mjs" },
    "./metaharness": { "types": "./src/metaharness.d.ts", "import": "./src/metaharness.mjs" },
    "./node": { "types": "./src/node.d.ts", "import": "./src/node.mjs" }
  },
  "files": ["src/", "README.md", "LICENSE-MIT", "LICENSE-APACHE"],
  "engines": { "node": ">=22.13.0" },
  "license": "MIT OR Apache-2.0",
  "homepage": "https://ruv.io",
  "repository": { "type": "git", "url": "https://github.com/ruvnet/ruv-FANN.git", "directory": "integrations/ruv-fann" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "example": "node examples/neural-search.mjs"
  },
  "dependencies": {
    "@ruvector/wasm": "0.2.1",
    "@metaharness/darwin": "0.13.0"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
